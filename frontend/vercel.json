{
  "rewrites": [
    {
      "source": "/:page(u|spots)/:rest*",
      "has": [{ "type": "header", "key": "user-agent", "value": ".*(facebookexternalhit|Facebot|WhatsApp|Twitterbot|TelegramBot|Slackbot|LinkedInBot|Discordbot|Pinterest|SkypeUriPreview|Googlebot|bingbot).*" }],
      "destination": "/api/og?path=/:page/:rest*"
    },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
