# ── Database ──────────────────────────────────────────────────────────────────
# Local dev (SQLite — no Docker needed):
DATABASE_URL=sqlite:///./flockgo_demo.db

# Local dev with Docker Compose (PostgreSQL):
# DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/flockgo

# Production (Render sets this automatically from the linked DB):
# DATABASE_URL=postgresql+psycopg2://user:pass@host:5432/flockgo

# ── LLM ───────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...

# ── App ───────────────────────────────────────────────────────────────────────
# Set to your Vercel frontend URL in production
FRONTEND_BASE_URL=http://localhost:5173

# development | production
ENVIRONMENT=development
