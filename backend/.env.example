# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./flockgo_demo.db
# DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/flockgo

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── LLM ───────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...

# ── App ───────────────────────────────────────────────────────────────────────
FRONTEND_BASE_URL=http://localhost:5173
ENVIRONMENT=development

# ── Auth ──────────────────────────────────────────────────────────────────────
# Master secret for admin endpoints (POST /v1/admin/api-keys)
# Leave blank in development — auth is disabled automatically
# In production: openssl rand -hex 32
API_SECRET_KEY=
