# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./flockgo_demo.db
# DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/flockgo

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── LLM ───────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...

# ── App ───────────────────────────────────────────────────────────────────────
FRONTEND_BASE_URL=http://localhost:5173
ENVIRONMENT=development

# ── Auth ──────────────────────────────────────────────────────────────────────
# Master secret for admin endpoints (POST /v1/admin/api-keys)
# Leave blank in development — auth is disabled automatically
# In production: openssl rand -hex 32
API_SECRET_KEY=

# ── India Travel APIs (Module 3 — Bus & Room Logistics Integrator) ────────────
# Leave blank to use stub/mock data (safe for dev and CI)
# Trawex Bus Booking API: https://www.trawex.com/bus-api.php
TRAWEX_API_URL=
TRAWEX_API_KEY=

# OpenTripMap (also used by India Sync) — for accommodation POI search
OPENTRIPMAP_API_KEY=
